{
  "database": {
    "instance": "astral-memes-zentraa-default-rtdb",
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "site": "c7mh9f9g2u",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/*.map"
      ],
      "rewrites": [
        {
          "source": "/hushmoto",
          "destination": "/hushmoto.html"
        },
        {
          "source": "/hushmoto/",
          "destination": "/hushmoto.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "redirects": [
        {
          "source": "/hush-moto",
          "destination": "/hushmoto",
          "type": 302
        },
        {
          "source": "/hush-moto/",
          "destination": "/hushmoto",
          "type": 302
        }
      ],
      "headers": [
        {
          "source": "/hushmoto",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/hushmoto/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/hushmoto.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/hush-moto-game/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/hush-moto-game/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            }
          ]
        }
      ]
    },
