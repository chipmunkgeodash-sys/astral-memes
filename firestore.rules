rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Auth emails are <local>@accounts.astralmemes.app. For most members the
    // local part is the uuid minted at sign-up and the account document id is
    // simply the auth uid. For the founding Owner the local part is their
    // username and the account lives at a fixed id (accounts/zentraa-owner),
    // so the id has to be looked up rather than assumed.
    function localPart() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.split('@')[0].lower()
        : '';
    }

    function myId() {
      return localPart() != ''
        && exists(/databases/$(database)/documents/usernames/$(localPart()))
        ? get(/databases/$(database)/documents/usernames/$(localPart())).data.uid
        : request.auth.uid;
    }

    function mine(id) {
      return signedIn() && myId() == id;
    }

    function myAccount() {
      return get(/databases/$(database)/documents/accounts/$(myId())).data;
    }

    function hasAccount() {
      return signedIn() && exists(/databases/$(database)/documents/accounts/$(myId()));
    }

    function isOwner() {
      return hasAccount() && 'owner' in myAccount().roleIds;
    }

    // Permission held directly on the account. Role-derived permissions are
    // enforced in the app; rules keep the destructive paths Owner-only.
    function can(perm) {
      return isOwner() || (hasAccount() && perm in myAccount().permissions);
    }

    // Must be readable while signed OUT: sign-in looks up the auth address
    // before authenticating.
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isOwner();
    }

    // Profiles are visible to any member. You edit your own; Owners edit anyone.
    // Roles and permissions stay Owner-only even on your own document.
    match /accounts/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && id == request.auth.uid
        && request.resource.data.roleIds.hasOnly(['member'])
        && request.resource.data.permissions.size() == 0;
      allow update: if isOwner()
        || (mine(id)
            && request.resource.data.roleIds == resource.data.roleIds
            && request.resource.data.permissions == resource.data.permissions);
      allow delete: if isOwner();
    }

    // A member may only ever DECREASE their own balance (redeeming). Any
    // increase must come from an Owner, so nobody can mint themselves coins.
    match /wallets/{id} {
      allow read: if signedIn();
      allow create: if isOwner()
        || (id == request.auth.uid && request.resource.data.balance == 0);
      allow update: if isOwner()
        || (mine(id) && request.resource.data.balance <= resource.data.balance);
      allow delete: if isOwner();
    }

    match /roles/{roleId} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == myId();
      // Anyone signed in may like; only the author or a moderator changes the rest.
      allow update: if signedIn() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        || mine(resource.data.uid) || can('moderateMemes')
      );
      allow delete: if mine(resource.data.uid) || can('moderateMemes') || isOwner();
    }

    function groupDoc(gid) {
      return get(/databases/$(database)/documents/groups/$(gid)).data;
    }

    // Owners are members of every group by definition, and the app shows them
    // in the member list — there is no hidden access.
    function inGroup(gid) {
      return isOwner()
        || (exists(/databases/$(database)/documents/groups/$(gid))
            && myId() in groupDoc(gid).members);
    }

    // Group chats are open to their members. Anyone may ask to join by adding
    // only themselves to `requests`; approving moves them into `members`, which
    // only the group's creator or an Owner can do.
    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == myId()
        && myId() in request.resource.data.members;
      allow update: if isOwner()
        || mine(resource.data.createdBy)
        // Anyone else may touch `requests` and nothing else, and the only name
        // they can add to it is their own.
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requests'])
            && request.resource.data.requests.hasOnly(resource.data.requests.concat([myId()]))
            && request.resource.data.requests.hasAll(resource.data.requests));
      allow delete: if isOwner() || mine(resource.data.createdBy);
    }

    // A message is readable in the global room, in a group you belong to, or in
    // a direct thread you are one half of. Nobody — Owner included — can read
    // other people's DMs.
    match /messages/{messageId} {
      allow read: if signedIn() && (
        resource.data.thread == 'the-lounge'
        || (resource.data.groupId != null && inGroup(resource.data.groupId))
        || myId() in resource.data.thread.split('__')
      );
      allow create: if signedIn()
        && request.resource.data.uid == myId()
        && (
          request.resource.data.thread == 'the-lounge'
          || (request.resource.data.groupId != null && inGroup(request.resource.data.groupId))
          || myId() in request.resource.data.thread.split('__')
        );
      allow update: if false;
      allow delete: if mine(resource.data.uid)
        || can('deleteMessages')
        || (resource.data.groupId != null && (isOwner() || can('manageChat')))
        || (resource.data.thread == 'the-lounge' && (isOwner() || can('manageChat')));
    }

    match /chat/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == myId();
      allow delete: if mine(resource.data.uid) || can('manageChat') || isOwner();
    }

    match /challenges/{challengeId} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // Your own entry only. Points are self-reported, as in the original.
    match /challengeEntries/{entryId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.uid == myId();
      allow delete: if isOwner();
    }

    match /polls/{pollId} {
      allow read: if signedIn();
      allow create, delete: if isOwner();
      // Members may only add or change their own vote key.
      allow update: if isOwner() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['votes.' + myId()])
      );
    }

    match /announcements/{id} {
      allow read: if signedIn();
      allow write: if isOwner() || can('manageAnnouncements');
    }

    match /storeItems/{id} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // Redemption and Owner-grant ledger. Append-only for members.
    match /redemptions/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isOwner();
    }

    // Record of removed content. Anyone deleting something writes a row; only
    // Owners can read it back, and nobody can rewrite history.
    match /deletionLog/{id} {
      allow read: if isOwner() || can('accessAdmin');
      allow create: if signedIn() && request.resource.data.deletedBy == myId();
      allow update: if false;
      allow delete: if isOwner();
    }

    // Everything not named above stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
